# Copy to .env and fill in. Only VITE_* variables reach the browser bundle.

# EmailJS credentials for the contact form (https://dashboard.emailjs.com).
# The public key is designed to be shipped to the client; the service and
# template ids are not secrets either, but keep them out of source control.
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=
